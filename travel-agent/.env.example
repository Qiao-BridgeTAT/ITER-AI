APP_ENV=development
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://travel_agent:travel_agent@localhost:5432/travel_agent
REDIS_URL=redis://localhost:6379/0
DEFAULT_TIMEZONE=Asia/Shanghai
PROVIDER_MODE=live

# Public browser configuration. Use a dedicated restricted browser key.
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_HOME_BACKGROUND_URL=
VITE_AMAP_JS_API_KEY=

# Server-only configuration. Inject values; never commit them.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_API_KEY=
AMAP_WEB_SERVICE_KEY=
# Server-side map proxy security code; do not expose it as a VITE_* variable.
AMAP_JS_SECURITY_CODE=
# Optional server-only POI search gateway. Configure both or neither; HTTPS only.
# Only /v3/place/{text,around,detail} and /v5/place/{text,around,detail} use this.
AMAP_SEARCH_PROXY_URL=
AMAP_SEARCH_PROXY_KEY=
AMAP_SEARCH_PROXY_KEY_PARAMETER=KEY
FLYAI_API_KEY=
WEATHER_API_KEY=
OPENWEATHER_API_KEY=
# SMS_PROVIDER: unavailable, tencent_cloud, or aliyun_phone_verification.
SMS_PROVIDER=unavailable
SMS_API_KEY=
SMS_API_SECRET=
# Tencent Cloud only.
SMS_APP_ID=
# For Aliyun Phone Verification, use your authorized sign and template code.
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
# ap-guangzhou for Tencent Cloud; cn-hangzhou for Aliyun Phone Verification.
SMS_REGION=
SESSION_SECRET=
PII_ENCRYPTION_KEY=
EXPORT_SIGNING_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_DOMAIN=localhost
ANONYMOUS_SESSION_TTL_SECONDS=3600
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_LOCAL_PATH=.local/artifacts
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# V2.0: model-directed Planner + independent Reviewer.
MODEL_PROVIDER=qwen
CONVERSATION_MODE=disabled
V4_PLANNER_ENABLED=true
V4_PLANNER_ENGINE=langgraph-react-2
V4_PLANNER_TIME_LIMIT_ENABLED=true
V4_PLANNER_MAX_DECISIONS=12
# Leave empty to use official AMap MCP for all map tools.
AMAP_SEARCH_MCP_URL=
# Optional official Tavily MCP web search.
TAVILY_MCP_ENABLED=false
TAVILY_MCP_AUTH_MODE=key
TAVILY_API_KEY=
