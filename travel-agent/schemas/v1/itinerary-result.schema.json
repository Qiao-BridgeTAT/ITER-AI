{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "assumption_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Assumption Id",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssumptionKind"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        }
      },
      "required": [
        "assumption_id",
        "kind",
        "description",
        "source"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "AssumptionKind": {
      "enum": [
        "user_override",
        "system_default",
        "data_missing",
        "planning_tradeoff"
      ],
      "title": "AssumptionKind",
      "type": "string"
    },
    "CityCode": {
      "enum": [
        "beijing",
        "nanjing"
      ],
      "title": "CityCode",
      "type": "string"
    },
    "CnyAmountRange": {
      "additionalProperties": false,
      "description": "A closed CNY range represented in integer fen.",
      "properties": {
        "currency": {
          "default": "CNY",
          "pattern": "^CNY$",
          "title": "Currency",
          "type": "string"
        },
        "maximum_fen": {
          "minimum": 0,
          "title": "Maximum Fen",
          "type": "integer"
        },
        "minimum_fen": {
          "minimum": 0,
          "title": "Minimum Fen",
          "type": "integer"
        }
      },
      "required": [
        "minimum_fen",
        "maximum_fen"
      ],
      "title": "CnyAmountRange",
      "type": "object"
    },
    "CostCategory": {
      "enum": [
        "lodging",
        "dining",
        "attraction_tickets",
        "local_transport"
      ],
      "title": "CostCategory",
      "type": "string"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "lodging_share_source": {
                "const": "system_default"
              }
            },
            "required": [
              "lodging_share_source"
            ]
          },
          "then": {
            "properties": {
              "lodging_share_divisor": {
                "const": 2
              }
            }
          }
        }
      ],
      "properties": {
        "excluded_costs": {
          "items": {
            "$ref": "#/$defs/ExcludedCostKind"
          },
          "title": "Excluded Costs",
          "type": "array",
          "uniqueItems": true
        },
        "fetched_at_note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Fetched At Note",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/CostLineItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "lodging_share_divisor": {
          "default": 2,
          "minimum": 1,
          "title": "Lodging Share Divisor",
          "type": "integer"
        },
        "lodging_share_source": {
          "$ref": "#/$defs/EvidenceSource",
          "default": "system_default"
        },
        "total_per_person": {
          "$ref": "#/$defs/CnyAmountRange"
        }
      },
      "required": [
        "items",
        "total_per_person",
        "fetched_at_note"
      ],
      "title": "CostEstimate",
      "type": "object",
      "x-travel-cost-total": {
        "amountField": "amount_per_person",
        "itemsField": "items",
        "totalField": "total_per_person"
      }
    },
    "CostLineItem": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "amount_per_person": {
                "not": {
                  "type": "null"
                }
              },
              "source_fact_ids": {
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "amount_per_person",
              "source_fact_ids"
            ]
          },
          "if": {
            "properties": {
              "availability": {
                "const": "missing"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "amount_per_person": {
                "type": "null"
              },
              "missing_reason": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "missing_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "missing_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "partial"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "missing_reason": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "missing_reason"
            ]
          }
        }
      ],
      "properties": {
        "amount_per_person": {
          "anyOf": [
            {
              "$ref": "#/$defs/CnyAmountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "availability": {
          "$ref": "#/$defs/DataAvailability"
        },
        "category": {
          "$ref": "#/$defs/CostCategory"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "source_fact_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Fact Ids",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "category",
        "availability"
      ],
      "title": "CostLineItem",
      "type": "object"
    },
    "DataAvailability": {
      "enum": [
        "available",
        "partial",
        "missing"
      ],
      "title": "DataAvailability",
      "type": "string"
    },
    "DayPlan": {
      "additionalProperties": false,
      "properties": {
        "buffer_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Buffer Minutes",
          "type": "integer"
        },
        "daily_cost_per_person": {
          "$ref": "#/$defs/CnyAmountRange"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/ItineraryEntry"
          },
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "estimated_walking_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Walking M"
        },
        "rest_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Rest Minutes",
          "type": "integer"
        },
        "theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Theme",
          "type": "string"
        },
        "transport_legs": {
          "items": {
            "$ref": "#/$defs/TransportLeg"
          },
          "title": "Transport Legs",
          "type": "array"
        }
      },
      "required": [
        "date",
        "theme",
        "entries",
        "daily_cost_per_person"
      ],
      "title": "DayPlan",
      "type": "object",
      "x-travel-day-plan": {
        "entriesField": "entries",
        "legsField": "transport_legs"
      }
    },
    "EvidenceSource": {
      "enum": [
        "cold_start",
        "card",
        "dialogue",
        "agent_inference",
        "system_default",
        "provider"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "ExcludedCostKind": {
      "enum": [
        "airfare",
        "rail",
        "intercity_transport"
      ],
      "title": "ExcludedCostKind",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "info",
        "warning",
        "hard"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "Itinerary": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "$ref": "#/$defs/CityCode"
        },
        "days": {
          "items": {
            "$ref": "#/$defs/DayPlan"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Days",
          "type": "array"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "city",
        "start_date",
        "end_date",
        "days"
      ],
      "title": "Itinerary",
      "type": "object",
      "x-travel-itinerary": {
        "dayDateField": "date",
        "daysField": "days",
        "endField": "end_date",
        "startField": "start_date"
      }
    },
    "ItineraryEntry": {
      "additionalProperties": false,
      "properties": {
        "end_time": {
          "format": "time",
          "title": "End Time",
          "type": "string"
        },
        "entry_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entry Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItineraryEntryKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "place_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Id"
        },
        "source_fact_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Fact Ids",
          "type": "array",
          "uniqueItems": true
        },
        "start_time": {
          "format": "time",
          "title": "Start Time",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "kind",
        "title",
        "start_time",
        "end_time"
      ],
      "title": "ItineraryEntry",
      "type": "object",
      "x-travel-time-range": {
        "endField": "end_time",
        "startField": "start_time"
      }
    },
    "ItineraryEntryKind": {
      "enum": [
        "attraction",
        "restaurant",
        "activity",
        "hotel",
        "rest",
        "buffer"
      ],
      "title": "ItineraryEntryKind",
      "type": "string"
    },
    "PlanningIssue": {
      "additionalProperties": false,
      "properties": {
        "affected_entry_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Affected Entry Ids",
          "type": "array",
          "uniqueItems": true
        },
        "code": {
          "$ref": "#/$defs/PlanningIssueCode"
        },
        "issue_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Issue Id",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "issue_id",
        "code",
        "severity",
        "message"
      ],
      "title": "PlanningIssue",
      "type": "object"
    },
    "PlanningIssueCode": {
      "enum": [
        "date_conflict",
        "opening_hours_conflict",
        "fixed_event_conflict",
        "insufficient_travel_time",
        "time_overlap",
        "walking_limit",
        "daily_load",
        "lodging_coverage",
        "repeated_experience",
        "cross_area_backtracking",
        "meal_timing",
        "insufficient_buffer",
        "weather_risk",
        "missing_data"
      ],
      "title": "PlanningIssueCode",
      "type": "string"
    },
    "TransportLeg": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/DataAvailability"
        },
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "fare": {
          "anyOf": [
            {
              "$ref": "#/$defs/CnyAmountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "from_entry_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "From Entry Id",
          "type": "string"
        },
        "leg_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Leg Id",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "mode": {
          "$ref": "#/$defs/TransportMode"
        },
        "source_fact_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Fact Ids",
          "type": "array",
          "uniqueItems": true
        },
        "to_entry_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "To Entry Id",
          "type": "string"
        },
        "walking_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walking M"
        }
      },
      "required": [
        "leg_id",
        "from_entry_id",
        "to_entry_id",
        "mode",
        "availability"
      ],
      "title": "TransportLeg",
      "type": "object"
    },
    "TransportMode": {
      "enum": [
        "walk",
        "bicycle",
        "public_transit",
        "taxi"
      ],
      "title": "TransportMode",
      "type": "string"
    }
  },
  "$id": "https://travel-agent.local/schemas/v1/itinerary-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "cost_estimate": {
      "$ref": "#/$defs/CostEstimate"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/PlanningIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "itinerary": {
      "$ref": "#/$defs/Itinerary"
    }
  },
  "required": [
    "itinerary",
    "cost_estimate"
  ],
  "title": "ItineraryResult",
  "type": "object",
  "x-travel-itinerary-result": {
    "costField": "cost_estimate",
    "dailyCostField": "daily_cost_per_person",
    "daysField": "days",
    "itineraryField": "itinerary",
    "totalField": "total_per_person"
  }
}
