{
  "$defs": {
    "CityCode": {
      "enum": [
        "beijing",
        "nanjing"
      ],
      "title": "CityCode",
      "type": "string"
    },
    "CnyAmountRange": {
      "additionalProperties": false,
      "description": "A closed CNY range represented in integer fen.",
      "properties": {
        "currency": {
          "default": "CNY",
          "pattern": "^CNY$",
          "title": "Currency",
          "type": "string"
        },
        "maximum_fen": {
          "minimum": 0,
          "title": "Maximum Fen",
          "type": "integer"
        },
        "minimum_fen": {
          "minimum": 0,
          "title": "Minimum Fen",
          "type": "integer"
        }
      },
      "required": [
        "minimum_fen",
        "maximum_fen"
      ],
      "title": "CnyAmountRange",
      "type": "object"
    },
    "DataAvailability": {
      "enum": [
        "available",
        "partial",
        "missing"
      ],
      "title": "DataAvailability",
      "type": "string"
    },
    "DayPlan": {
      "additionalProperties": false,
      "properties": {
        "buffer_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Buffer Minutes",
          "type": "integer"
        },
        "daily_cost_per_person": {
          "$ref": "#/$defs/CnyAmountRange"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/ItineraryEntry"
          },
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "estimated_walking_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Walking M"
        },
        "rest_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Rest Minutes",
          "type": "integer"
        },
        "theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Theme",
          "type": "string"
        },
        "transport_legs": {
          "items": {
            "$ref": "#/$defs/TransportLeg"
          },
          "title": "Transport Legs",
          "type": "array"
        }
      },
      "required": [
        "date",
        "theme",
        "entries",
        "daily_cost_per_person"
      ],
      "title": "DayPlan",
      "type": "object",
      "x-travel-day-plan": {
        "entriesField": "entries",
        "legsField": "transport_legs"
      }
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "sequence": {
                "minimum": 1,
                "type": "integer"
              }
            }
          },
          "if": {
            "properties": {
              "generation_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "sequence": {
                "const": 0,
                "type": "integer"
              }
            }
          }
        }
      ],
      "properties": {
        "base_state_version": {
          "minimum": 0,
          "title": "Base State Version",
          "type": "integer"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "generation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation Id"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ErrorEventPayload"
        },
        "protocol_version": {
          "const": "1.0.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "state_version": {
          "minimum": 0,
          "title": "State Version",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        }
