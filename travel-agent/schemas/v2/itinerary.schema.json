{
  "$defs": {
    "CityCode": {
      "enum": [
        "beijing",
        "nanjing"
      ],
      "title": "CityCode",
      "type": "string"
    },
    "CnyAmountRange": {
      "additionalProperties": false,
      "description": "A closed CNY range represented in integer fen.",
      "properties": {
        "currency": {
          "default": "CNY",
          "pattern": "^CNY$",
          "title": "Currency",
          "type": "string"
        },
        "maximum_fen": {
          "minimum": 0,
          "title": "Maximum Fen",
          "type": "integer"
        },
        "minimum_fen": {
          "minimum": 0,
          "title": "Minimum Fen",
          "type": "integer"
        }
      },
      "required": [
        "minimum_fen",
        "maximum_fen"
      ],
      "title": "CnyAmountRange",
      "type": "object"
    },
    "DataAvailability": {
      "enum": [
        "available",
        "partial",
        "missing"
      ],
      "title": "DataAvailability",
      "type": "string"
    },
    "DayPlan": {
      "additionalProperties": false,
      "properties": {
        "buffer_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Buffer Minutes",
          "type": "integer"
        },
        "daily_cost_per_person": {
          "$ref": "#/$defs/CnyAmountRange"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/ItineraryEntry"
          },
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        },
        "estimated_walking_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Walking M"
        },
        "rest_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Rest Minutes",
          "type": "integer"
        },
        "theme": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Theme",
          "type": "string"
        },
        "transport_legs": {
          "items": {
            "$ref": "#/$defs/TransportLeg"
          },
          "title": "Transport Legs",
          "type": "array"
        }
      },
      "required": [
        "date",
        "theme",
        "entries",
        "daily_cost_per_person"
      ],
      "title": "DayPlan",
      "type": "object",
      "x-travel-day-plan": {
        "entriesField": "entries",
        "legsField": "transport_legs"
      }
    },
    "ItineraryEntry": {
      "additionalProperties": false,
      "properties": {
        "end_time": {
          "format": "time",
          "title": "End Time",
          "type": "string"
        },
        "entry_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entry Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItineraryEntryKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "place_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Id"
        },
        "source_fact_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Fact Ids",
          "type": "array",
          "uniqueItems": true
        },
        "start_time": {
          "format": "time",
          "title": "Start Time",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "kind",
        "title",
        "start_time",
        "end_time"
      ],
      "title": "ItineraryEntry",
      "type": "object",
      "x-travel-time-range": {
        "endField": "end_time",
        "startField": "start_time"
      }
    },
    "ItineraryEntryKind": {
      "enum": [
        "attraction",
        "restaurant",
        "activity",
        "hotel",
        "rest",
        "buffer"
      ],
      "title": "ItineraryEntryKind",
      "type": "string"
    },
    "TransportLeg": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/DataAvailability"
        },
        "distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "fare": {
          "anyOf": [
            {
              "$ref": "#/$defs/CnyAmountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "from_entry_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "From Entry Id",
          "type": "string"
        },
        "leg_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Leg Id",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "mode": {
          "$ref": "#/$defs/TransportMode"
        },
        "source_fact_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Fact Ids",
          "type": "array",
          "uniqueItems": true
        },
        "to_entry_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "To Entry Id",
          "type": "string"
        },
        "walking_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walking M"
        }
      },
      "required": [
        "leg_id",
        "from_entry_id",
        "to_entry_id",
        "mode",
        "availability"
      ],
      "title": "TransportLeg",
      "type": "object"
    },
    "TransportMode": {
      "enum": [
        "walk",
        "bicycle",
        "public_transit",
        "taxi"
      ],
      "title": "TransportMode",
      "type": "string"
    }
  },
  "$id": "https://travel-agent.local/schemas/v2/itinerary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "city": {
      "$ref": "#/$defs/CityCode"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/DayPlan"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Days",
      "type": "array"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    }
  },
  "required": [
    "city",
    "start_date",
    "end_date",
    "days"
  ],
  "title": "Itinerary",
  "type": "object",
  "x-travel-itinerary": {
    "dayDateField": "date",
    "daysField": "days",
    "endField": "end_date",
    "startField": "start_date"
  }
}
