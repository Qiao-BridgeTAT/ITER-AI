{
  "$id": "https://travel-agent.local/schemas/v2/update-account-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "nickname": {
      "maxLength": 20,
      "minLength": 1,
