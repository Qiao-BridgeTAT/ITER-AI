{
  "$defs": {
    "CandidateDomain": {
      "enum": [
        "attraction",
        "restaurant",
        "hotel"
      ],
      "title": "CandidateDomain",
      "type": "string"
    },
    "CandidateHardConflict": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/CandidateHardConflictCode"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source_reference_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "code",
        "reason",
        "source_reference_ids"
      ],
      "title": "CandidateHardConflict",
      "type": "object"
    },
    "CandidateHardConflictCode": {
      "enum": [
        "explicitly_excluded",
        "closed_on_trip_date",
        "fixed_schedule_conflict",
        "special_constraint_violation",
        "wrong_city",
        "wrong_domain"
      ],
      "title": "CandidateHardConflictCode",
      "type": "string"
    },
    "CandidateSourceReference": {
      "additionalProperties": false,
      "properties": {
        "content_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Version"
        },
        "fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        },
        "kind": {
          "$ref": "#/$defs/RecallSourceKind"
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_place_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Place Id"
        },
        "source_record_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Record Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "kind",
        "source_record_id"
      ],
      "title": "CandidateSourceReference",
      "type": "object"
    },
    "CnyAmountRange": {
      "additionalProperties": false,
      "description": "A closed CNY range represented in integer fen.",
      "properties": {
        "currency": {
          "default": "CNY",
          "pattern": "^CNY$",
          "title": "Currency",
          "type": "string"
        },
        "maximum_fen": {
          "minimum": 0,
          "title": "Maximum Fen",
          "type": "integer"
        },
        "minimum_fen": {
          "minimum": 0,
          "title": "Minimum Fen",
          "type": "integer"
        }
      },
      "required": [
        "minimum_fen",
        "maximum_fen"
      ],
      "title": "CnyAmountRange",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DataAvailability": {
      "enum": [
        "available",
        "partial",
        "missing"
      ],
      "title": "DataAvailability",
      "type": "string"
    },
    "FilteredCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/RecalledCandidate"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/CandidateHardConflict"
          },
          "minItems": 1,
          "title": "Conflicts",
          "type": "array"
        },
        "merged_candidate_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Merged Candidate Ids",
          "type": "array"
        },
        "was_strong_desire": {
          "default": false,
          "title": "Was Strong Desire",
          "type": "boolean"
        }
      },
      "required": [
        "candidate",
        "merged_candidate_ids",
        "conflicts"
      ],
      "title": "FilteredCandidate",
      "type": "object"
    },
    "Gcj02Coordinates": {
      "additionalProperties": false,
      "description": "Canonical coordinates used by every internal planning contract.",
      "properties": {
        "coord_system": {
          "const": "gcj_02",
          "title": "Coord System",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "coord_system"
      ],
      "title": "Gcj02Coordinates",
      "type": "object"
    },
    "PlaceCategory": {
      "enum": [
        "attraction",
        "restaurant",
        "hotel",
        "transport",
        "activity",
        "other"
      ],
      "title": "PlaceCategory",
      "type": "string"
    },
    "ProviderCode": {
      "enum": [
        "amap",
        "baidu",
        "flyai",
        "weather",
        "city_content",
        "official",
        "manual"
      ],
      "title": "ProviderCode",
      "type": "string"
    },
    "RankedCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/RecalledCandidate"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/RankingScoreComponent"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Components",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "explanations": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Explanations",
          "type": "array"
        },
        "merged_candidate_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Merged Candidate Ids",
          "type": "array"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "recommendation_origin": {
          "const": "system_recommendation",
          "default": "system_recommendation",
          "title": "Recommendation Origin",
          "type": "string"
        },
        "selection_status": {
          "$ref": "#/$defs/RankingSelectionStatus"
        },
        "soft_risks": {
          "default": [],
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Soft Risks",
          "type": "array"
        },
        "total_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Total Score",
          "type": "integer"
        }
      },
      "required": [
        "rank",
        "selection_status",
        "candidate",
        "merged_candidate_ids",
        "components",
        "total_score",
        "confidence",
        "explanations"
      ],
      "title": "RankedCandidate",
      "type": "object"
    },
    "RankingFactor": {
      "enum": [
        "strong_desire",
        "preference_match",
        "spatial_cost",
        "time_cost",
        "fact_completeness",
        "source_trust"
      ],
      "title": "RankingFactor",
      "type": "string"
    },
    "RankingScoreComponent": {
      "additionalProperties": false,
      "properties": {
        "factor": {
          "$ref": "#/$defs/RankingFactor"
        },
        "raw_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Raw Score",
          "type": "integer"
        },
        "weight_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Weight Percent",
          "type": "integer"
        },
        "weighted_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Weighted Score",
          "type": "integer"
        }
      },
      "required": [
        "factor",
        "raw_score",
        "weight_percent",
        "weighted_score"
      ],
      "title": "RankingScoreComponent",
      "type": "object"
    },
    "RankingSelectionStatus": {
      "enum": [
        "recommended",
        "reserve"
      ],
      "title": "RankingSelectionStatus",
      "type": "string"
    },
    "RecallChannel": {
      "enum": [
        "user_named",
        "selected_theme",
        "city_landmark",
        "city_feature",
        "exploration",
        "nearby_anchor"
      ],
      "title": "RecallChannel",
      "type": "string"
    },
    "RecallSourceKind": {
      "enum": [
        "user_evidence",
        "city_content",
        "provider"
      ],
      "title": "RecallSourceKind",
      "type": "string"
    },
    "RecalledCandidate": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/DataAvailability"
        },
        "candidate_id": {
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "channels": {
          "items": {
            "$ref": "#/$defs/RecallChannel"
          },
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "domain": {
          "$ref": "#/$defs/CandidateDomain"
        },
        "missing_fields": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "named_evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Named Evidence Ids",
          "type": "array"
        },
        "place": {
          "$ref": "#/$defs/RecalledPlace"
        },
        "reasons": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "representative_identity_verified": {
          "default": false,
          "title": "Representative Identity Verified",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/CandidateSourceReference"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "theme_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Theme Ids",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "domain",
        "place",
        "channels",
        "reasons",
        "sources",
        "availability"
      ],
      "title": "RecalledCandidate",
      "type": "object"
    },
    "RecalledPlace": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "average_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/CnyAmountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category": {
          "$ref": "#/$defs/PlaceCategory"
        },
        "city_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "City Id",
          "type": "string"
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gcj02Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cuisine": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuisine"
        },
        "image_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        },
        "provider_parent_place_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Parent Place Id"
        },
        "provider_typecode": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Typecode"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "short_description": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Description"
        }
      },
      "required": [
        "place_id",
        "city_id",
        "category",
        "name"
      ],
      "title": "RecalledPlace",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v2/candidate-ranking-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RankedCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "city_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "City Id",
      "type": "string"
    },
    "config_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Config Id",
      "type": "string"
    },
    "deduplicated_candidate_count": {
      "maximum": 40,
      "minimum": 0,
      "title": "Deduplicated Candidate Count",
      "type": "integer"
    },
    "degradation_reasons": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Degradation Reasons",
      "type": "array"
    },
    "filtered_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FilteredCandidate"
      },
      "title": "Filtered Candidates",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "input_candidate_count": {
      "maximum": 40,
      "minimum": 0,
      "title": "Input Candidate Count",
      "type": "integer"
    },
    "ranking_request_id": {
      "format": "uuid",
      "title": "Ranking Request Id",
      "type": "string"
    },
    "ranking_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Ranking Version",
      "type": "string"
    },
    "recall_request_id": {
      "format": "uuid",
      "title": "Recall Request Id",
      "type": "string"
    },
    "recommendation_limit": {
      "maximum": 14,
      "minimum": 1,
      "title": "Recommendation Limit",
      "type": "integer"
    },
    "semantic_state_version": {
      "default": 0,
      "minimum": 0,
      "title": "Semantic State Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/DataAvailability"
    },
    "task_book_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Book Id"
    },
    "task_book_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Book Revision"
    },
    "trip_id": {
      "format": "uuid",
      "title": "Trip Id",
      "type": "string"
    }
  },
  "required": [
    "ranking_version",
    "config_id",
    "ranking_request_id",
    "recall_request_id",
    "trip_id",
    "city_id",
    "status",
    "input_candidate_count",
    "deduplicated_candidate_count",
    "recommendation_limit",
    "generated_at"
  ],
  "title": "CandidateRankingResult",
  "type": "object"
}
