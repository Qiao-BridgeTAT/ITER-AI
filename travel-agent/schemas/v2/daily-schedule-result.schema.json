{
  "$defs": {
    "AnchorRole": {
      "enum": [
        "fixed_event",
        "fixed_hotel",
        "must_attraction",
        "want_attraction",
        "destination_restaurant",
        "convenient_attraction",
        "convenient_restaurant"
      ],
      "title": "AnchorRole",
      "type": "string"
    },
    "DataAvailability": {
      "enum": [
        "available",
        "partial",
        "missing"
      ],
      "title": "DataAvailability",
      "type": "string"
    },
    "RouteMode": {
      "enum": [
        "walking",
        "cycling",
        "transit",
        "driving"
      ],
      "title": "RouteMode",
      "type": "string"
    },
    "ScheduleActivityKind": {
      "enum": [
        "attraction",
        "restaurant",
        "fixed_event"
      ],
      "title": "ScheduleActivityKind",
      "type": "string"
    },
    "SchedulePauseKind": {
      "enum": [
        "meal",
        "rest"
      ],
      "title": "SchedulePauseKind",
      "type": "string"
    },
    "ScheduledActivity": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "format": "uuid",
          "title": "Activity Id",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/DataAvailability"
        },
        "duration_minutes": {
          "maximum": 480,
          "minimum": 1,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "end_time": {
          "format": "time",
          "title": "End Time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ScheduleActivityKind"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "node_id": {
          "format": "uuid",
          "title": "Node Id",
          "type": "string"
        },
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AnchorRole"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        },
        "source_reference_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        },
        "start_time": {
          "format": "time",
          "title": "Start Time",
          "type": "string"
        },
        "timing_notice": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timing Notice"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "activity_id",
        "node_id",
        "place_id",
        "kind",
        "role",
        "title",
        "service_date",
        "start_time",
        "end_time",
        "duration_minutes",
        "availability",
        "source_reference_ids"
      ],
      "title": "ScheduledActivity",
      "type": "object"
    },
    "ScheduledDay": {
      "additionalProperties": false,
      "properties": {
        "active_minutes": {
          "minimum": 0,
          "title": "Active Minutes",
          "type": "integer"
        },
        "activities": {
          "items": {
            "$ref": "#/$defs/ScheduledActivity"
          },
          "title": "Activities",
          "type": "array"
        },
        "buffer_minutes": {
          "minimum": 0,
          "title": "Buffer Minutes",
          "type": "integer"
        },
        "cycling_m": {
          "default": 0,
          "minimum": 0,
          "title": "Cycling M",
          "type": "integer"
        },
        "end_place_id": {
          "format": "uuid",
          "title": "End Place Id",
          "type": "string"
        },
        "end_time": {
          "format": "time",
          "title": "End Time",
          "type": "string"
        },
        "meal_minutes": {
          "minimum": 0,
          "title": "Meal Minutes",
          "type": "integer"
        },
        "pauses": {
          "items": {
            "$ref": "#/$defs/ScheduledPause"
          },
          "title": "Pauses",
          "type": "array"
        },
        "rest_minutes": {
          "minimum": 0,
          "title": "Rest Minutes",
          "type": "integer"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        },
        "start_place_id": {
          "format": "uuid",
          "title": "Start Place Id",
          "type": "string"
        },
        "start_time": {
          "format": "time",
          "title": "Start Time",
          "type": "string"
        },
        "transport_legs": {
          "items": {
            "$ref": "#/$defs/ScheduledTransport"
          },
          "title": "Transport Legs",
          "type": "array"
        },
        "walking_m": {
          "minimum": 0,
          "title": "Walking M",
          "type": "integer"
        }
      },
      "required": [
        "service_date",
        "start_place_id",
        "end_place_id",
        "start_time",
        "end_time",
        "activities",
        "pauses",
        "transport_legs",
        "active_minutes",
        "walking_m",
        "meal_minutes",
        "rest_minutes",
        "buffer_minutes"
      ],
      "title": "ScheduledDay",
      "type": "object"
    },
    "ScheduledPause": {
      "additionalProperties": false,
      "properties": {
        "duration_minutes": {
          "maximum": 180,
          "minimum": 1,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "end_time": {
          "format": "time",
          "title": "End Time",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SchedulePauseKind"
        },
        "pause_id": {
          "format": "uuid",
          "title": "Pause Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        },
        "start_time": {
          "format": "time",
          "title": "Start Time",
          "type": "string"
        }
      },
      "required": [
        "pause_id",
        "kind",
        "service_date",
        "start_time",
        "end_time",
        "duration_minutes",
        "reason"
      ],
      "title": "ScheduledPause",
      "type": "object"
    },
    "ScheduledTransport": {
      "additionalProperties": false,
      "properties": {
        "arrival_time": {
          "format": "time",
          "title": "Arrival Time",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/DataAvailability"
        },
        "buffer_minutes": {
          "maximum": 45,
          "minimum": 0,
          "title": "Buffer Minutes",
          "type": "integer"
        },
        "departure_time": {
          "format": "time",
          "title": "Departure Time",
          "type": "string"
        },
        "destination_place_id": {
          "format": "uuid",
          "title": "Destination Place Id",
          "type": "string"
        },
        "distance_m": {
          "title": "Distance M",
          "type": "integer"
        },
        "duration_minutes": {
          "maximum": 360,
          "minimum": 0,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "leg_id": {
          "format": "uuid",
          "title": "Leg Id",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "mode": {
          "$ref": "#/$defs/RouteMode"
        },
        "origin_place_id": {
          "format": "uuid",
          "title": "Origin Place Id",
          "type": "string"
        },
        "source_reference_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        },
        "walking_m": {
          "minimum": 0,
          "title": "Walking M",
          "type": "integer"
        }
      },
      "required": [
        "leg_id",
        "origin_place_id",
        "destination_place_id",
        "departure_time",
        "arrival_time",
        "mode",
        "availability",
        "distance_m",
        "duration_minutes",
        "walking_m",
        "buffer_minutes",
        "source_reference_ids"
      ],
      "title": "ScheduledTransport",
      "type": "object"
    },
    "UnscheduledStrongDesire": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "format": "uuid",
          "title": "Node Id",
          "type": "string"
        },
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AnchorRole"
        },
        "source_reference_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "place_id",
        "role",
        "reason",
        "source_reference_ids"
      ],
      "title": "UnscheduledStrongDesire",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v2/daily-schedule-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Algorithm Version",
      "type": "string"
    },
    "city_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "City Id",
      "type": "string"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/ScheduledDay"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Days",
      "type": "array"
    },
    "degradation_reasons": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Degradation Reasons",
      "type": "array"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "input_state_version": {
      "minimum": 0,
      "title": "Input State Version",
      "type": "integer"
    },
    "provider_fact_ids": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Provider Fact Ids",
      "type": "array"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DataAvailability"
    },
    "task_book_id": {
      "format": "uuid",
      "title": "Task Book Id",
      "type": "string"
    },
    "task_book_revision": {
      "minimum": 1,
      "title": "Task Book Revision",
      "type": "integer"
    },
    "trip_id": {
      "format": "uuid",
      "title": "Trip Id",
      "type": "string"
    },
    "unscheduled_strong_desires": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UnscheduledStrongDesire"
      },
      "title": "Unscheduled Strong Desires",
      "type": "array"
    }
  },
  "required": [
    "algorithm_version",
    "request_id",
    "trip_id",
    "input_state_version",
    "task_book_id",
    "task_book_revision",
    "city_id",
    "start_date",
    "end_date",
    "status",
    "days",
    "generated_at"
  ],
  "title": "DailyScheduleResult",
  "type": "object"
}
