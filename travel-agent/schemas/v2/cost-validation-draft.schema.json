{
  "$defs": {
    "CostCategory": {
      "enum": [
        "lodging",
        "dining",
        "attraction_tickets",
        "local_transport"
      ],
      "title": "CostCategory",
      "type": "string"
    },
    "CostCoverageStatus": {
      "enum": [
        "available",
        "partial",
        "missing",
        "not_applicable"
      ],
      "title": "CostCoverageStatus",
      "type": "string"
    },
    "CostPriceBasis": {
      "enum": [
        "per_person",
        "per_vehicle",
        "per_room_night"
      ],
      "title": "CostPriceBasis",
      "type": "string"
    },
    "CostSubjectKind": {
      "enum": [
        "activity",
        "transport_leg",
        "hotel_night"
      ],
      "title": "CostSubjectKind",
      "type": "string"
    },
    "DataAvailability": {
      "enum": [
        "available",
        "partial",
        "missing"
      ],
      "title": "DataAvailability",
      "type": "string"
    },
    "DraftAmountRange": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "maximum_fen": {
          "title": "Maximum Fen",
          "type": "integer"
        },
        "minimum_fen": {
          "title": "Minimum Fen",
          "type": "integer"
        }
      },
      "required": [
        "currency",
        "minimum_fen",
        "maximum_fen"
      ],
      "title": "DraftAmountRange",
      "type": "object"
    },
    "DraftCategoryCostSummary": {
      "additionalProperties": false,
      "properties": {
        "amount_per_person": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftAmountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category": {
          "$ref": "#/$defs/CostCategory"
        },
        "missing_item_count": {
          "title": "Missing Item Count",
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "priced_item_count": {
          "title": "Priced Item Count",
          "type": "integer"
        },
        "source_reference_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Reference Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CostCoverageStatus"
        }
      },
      "required": [
        "category",
        "status",
        "priced_item_count",
        "missing_item_count"
      ],
      "title": "DraftCategoryCostSummary",
      "type": "object"
    },
    "DraftCostEstimateLine": {
      "additionalProperties": false,
      "properties": {
        "amount_per_person": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftAmountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "availability": {
          "$ref": "#/$defs/DataAvailability"
        },
        "basis": {
          "$ref": "#/$defs/CostPriceBasis"
        },
        "category": {
          "$ref": "#/$defs/CostCategory"
        },
        "exchange_rate_fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Rate Fetched At"
        },
        "exchange_rate_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Rate Id"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "original_amount": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Amount"
        },
        "price_fact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Price Fact Id",
          "type": "string"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        },
        "share_divisor": {
          "title": "Share Divisor",
          "type": "integer"
        },
        "source_reference_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Source Reference Ids",
          "type": "array"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_kind": {
          "$ref": "#/$defs/CostSubjectKind"
        }
      },
      "required": [
        "price_fact_id",
        "subject_kind",
        "subject_id",
        "service_date",
        "category",
        "basis",
        "share_divisor",
        "availability",
        "fetched_at"
      ],
      "title": "DraftCostEstimateLine",
      "type": "object"
    },
    "DraftDailyCostEstimate": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DraftCategoryCostSummary"
          },
          "title": "Categories",
          "type": "array"
        },
        "known_subtotal_per_person": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftAmountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DraftCostEstimateLine"
          },
          "title": "Lines",
          "type": "array"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        }
      },
      "required": [
        "service_date"
      ],
      "title": "DraftDailyCostEstimate",
      "type": "object"
    },
    "ExcludedCostKind": {
      "enum": [
        "airfare",
        "rail",
        "intercity_transport"
      ],
      "title": "ExcludedCostKind",
      "type": "string"
    }
  },
  "$id": "https://travel-agent.local/schemas/v2/cost-validation-draft.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "title": "Algorithm Version",
      "type": "string"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/DraftCategoryCostSummary"
      },
      "title": "Categories",
      "type": "array"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/DraftDailyCostEstimate"
      },
      "title": "Days",
      "type": "array"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "excluded_costs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExcludedCostKind"
      },
      "title": "Excluded Costs",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "input_state_version": {
      "title": "Input State Version",
      "type": "integer"
    },
    "known_total_per_person": {
      "anyOf": [
        {
          "$ref": "#/$defs/DraftAmountRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lodging_share_divisor": {
      "title": "Lodging Share Divisor",
      "type": "integer"
    },
    "party_size": {
      "title": "Party Size",
      "type": "integer"
    },
    "per_person": {
      "title": "Per Person",
      "type": "boolean"
    },
    "pricing_note": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Pricing Note",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schedule_request_id": {
      "format": "uuid",
      "title": "Schedule Request Id",
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "task_book_id": {
      "format": "uuid",
      "title": "Task Book Id",
      "type": "string"
    },
    "task_book_revision": {
      "title": "Task Book Revision",
      "type": "integer"
    },
    "trip_id": {
      "format": "uuid",
      "title": "Trip Id",
      "type": "string"
    }
  },
  "required": [
    "algorithm_version",
    "request_id",
    "schedule_request_id",
    "trip_id",
    "input_state_version",
    "task_book_id",
    "task_book_revision",
    "start_date",
    "end_date",
    "currency",
    "per_person",
    "party_size",
    "lodging_share_divisor",
    "days",
    "categories",
    "pricing_note",
    "generated_at"
  ],
  "title": "CostValidationDraft",
  "type": "object"
}
