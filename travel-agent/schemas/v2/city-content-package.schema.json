{
  "$defs": {
    "AssetKind": {
      "enum": [
        "illustration",
        "placeholder",
        "photo"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetRightsStatus": {
      "enum": [
        "owned",
        "placeholder",
        "licensed"
      ],
      "title": "AssetRightsStatus",
      "type": "string"
    },
    "CityAsset": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "rights_status": {
                "const": "licensed"
              }
            },
            "required": [
              "rights_status"
            ]
          },
          "then": {
            "properties": {
              "attribution": {
                "not": {
                  "type": "null"
                }
              },
              "license_name": {
                "not": {
                  "type": "null"
                }
              },
              "source_url": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "license_name",
              "attribution",
              "source_url"
            ]
          }
        }
      ],
      "properties": {
        "asset_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Asset Id",
          "type": "string"
        },
        "attribution": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "license_name": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Name"
        },
        "rights_status": {
          "$ref": "#/$defs/AssetRightsStatus"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "uri": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "uri",
        "rights_status"
      ],
      "title": "CityAsset",
      "type": "object"
    },
    "CityBriefContent": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "history_degradation_note": {
                "not": {
                  "type": "null"
                }
              },
              "history_nodes": {
                "maxItems": 0,
                "type": "array"
              }
            },
            "required": [
              "history_degradation_note"
            ]
          },
          "if": {
            "properties": {
              "history_status": {
                "const": "available"
              }
            },
            "required": [
              "history_status"
            ]
          },
          "then": {
            "properties": {
              "history_degradation_note": {
                "type": "null"
              },
              "history_nodes": {
                "maxItems": 4,
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ],
      "properties": {
        "experience_directions": {
          "items": {
            "$ref": "#/$defs/CityExperienceDirection"
          },
          "maxItems": 6,
          "minItems": 4,
          "title": "Experience Directions",
          "type": "array"
        },
        "history_degradation_note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Degradation Note"
        },
        "history_nodes": {
          "items": {
            "$ref": "#/$defs/CityHistoryNode"
          },
          "maxItems": 4,
          "title": "History Nodes",
          "type": "array"
        },
        "history_status": {
          "$ref": "#/$defs/CityHistoryStatus"
        },
        "one_sentence": {
          "maxLength": 500,
          "minLength": 1,
          "title": "One Sentence",
          "type": "string"
        },
        "planning_tradeoff": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Planning Tradeoff",
          "type": "string"
        },
        "spatial_relationships": {
          "items": {
            "$ref": "#/$defs/CitySpatialRelationship"
          },
          "minItems": 1,
          "title": "Spatial Relationships",
          "type": "array"
        }
      },
      "required": [
        "one_sentence",
        "history_status",
        "experience_directions",
        "spatial_relationships",
        "planning_tradeoff"
      ],
      "title": "CityBriefContent",
      "type": "object"
    },
    "CityCode": {
      "enum": [
        "beijing",
        "nanjing"
      ],
      "title": "CityCode",
      "type": "string"
    },
    "CityContentSource": {
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Publisher",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "publisher",
        "url",
        "retrieved_at"
      ],
      "title": "CityContentSource",
      "type": "object"
    },
    "CityExperienceDirection": {
      "additionalProperties": false,
      "properties": {
        "direction_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Direction Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "typical_places": {
          "items": {
            "$ref": "#/$defs/TypicalPlace"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Typical Places",
          "type": "array"
        }
      },
      "required": [
        "direction_id",
        "label",
        "summary",
        "typical_places",
        "source_ids"
      ],
      "title": "CityExperienceDirection",
      "type": "object"
    },
    "CityHistoryNode": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Period",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "period",
        "title",
        "summary",
        "source_ids"
      ],
      "title": "CityHistoryNode",
      "type": "object"
    },
    "CityHistoryStatus": {
      "enum": [
        "available",
        "not_applicable",
        "unavailable"
      ],
      "title": "CityHistoryStatus",
      "type": "string"
    },
    "CitySpatialRelationship": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "related_place_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 2,
          "title": "Related Place Ids",
          "type": "array"
        },
        "relationship_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Relationship Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "relationship_id",
        "description",
        "related_place_ids",
        "source_ids"
      ],
      "title": "CitySpatialRelationship",
      "type": "object"
    },
    "CityThemeContent": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "theme_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Theme Id",
          "type": "string"
        }
      },
      "required": [
        "theme_id",
        "label",
        "summary",
        "source_ids"
      ],
      "title": "CityThemeContent",
      "type": "object"
    },
    "CoreAttractionContent": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Asset Id",
          "type": "string"
        },
        "city_importance": {
          "maxLength": 500,
          "minLength": 1,
          "title": "City Importance",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        },
        "recommended_duration_minutes": {
          "maximum": 720,
          "minimum": 30,
          "title": "Recommended Duration Minutes",
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "theme_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Theme Ids",
          "type": "array"
        },
        "tradeoffs": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Tradeoffs",
          "type": "array"
        },
        "visitor_experience": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Visitor Experience",
          "type": "string"
        }
      },
      "required": [
        "place_id",
        "name",
        "theme_ids",
        "city_importance",
        "visitor_experience",
        "recommended_duration_minutes",
        "tradeoffs",
        "source_ids",
        "asset_id"
      ],
      "title": "CoreAttractionContent",
      "type": "object"
    },
    "TypicalPlace": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "place_id",
        "name",
        "source_ids"
      ],
      "title": "TypicalPlace",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v2/city-content-package.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Legacy Beijing/Nanjing package retained for frozen UI fixtures.",
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/CityAsset"
      },
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "city": {
      "$ref": "#/$defs/CityCode"
    },
    "city_brief": {
      "$ref": "#/$defs/CityBriefContent"
    },
    "content_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Content Version",
      "type": "string"
    },
    "core_attractions": {
      "items": {
        "$ref": "#/$defs/CoreAttractionContent"
      },
      "maxItems": 40,
      "minItems": 30,
      "title": "Core Attractions",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CityContentSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "themes": {
      "items": {
        "$ref": "#/$defs/CityThemeContent"
      },
      "maxItems": 8,
      "minItems": 6,
      "title": "Themes",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "content_version",
    "created_at",
    "updated_at",
    "sources",
    "assets",
    "city_brief",
    "themes",
    "core_attractions",
    "city"
  ],
  "title": "CityContentPackage",
  "type": "object",
  "x-travel-city-content": {
    "assetIdField": "asset_id",
    "assetsField": "assets",
    "attractionsField": "core_attractions",
    "briefField": "city_brief",
    "createdField": "created_at",
    "placeIdField": "place_id",
    "sourceIdField": "source_id",
    "sourcesField": "sources",
    "themeIdField": "theme_id",
    "themesField": "themes",
    "updatedField": "updated_at"
  }
}
