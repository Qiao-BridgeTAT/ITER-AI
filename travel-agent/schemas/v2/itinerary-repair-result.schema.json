  "$id": "https://travel-agent.local/schemas/v2/itinerary-repair-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Algorithm Version",
      "type": "string"
    },
    "best_cost_draft": {
      "$ref": "#/$defs/CostValidationDraft"
    },
    "best_schedule_draft": {
      "$ref": "#/$defs/ScheduleValidationDraft"
    },
    "final_validation": {
      "$ref": "#/$defs/ItineraryValidationResult"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generation_id": {
      "format": "uuid",
      "title": "Generation Id",
      "type": "string"
    },
    "input_state_version": {
      "minimum": 0,
      "title": "Input State Version",
      "type": "integer"
    },
    "remaining_issue_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Remaining Issue Ids",
      "type": "array"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "rounds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RepairRoundRecord"
      },
      "maxItems": 2,
      "title": "Rounds",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/RepairRunStatus"
    },
    "strict_ready": {
      "title": "Strict Ready",
      "type": "boolean"
    },
    "trip_id": {
      "format": "uuid",
      "title": "Trip Id",
      "type": "string"
    }
  },
  "required": [
    "algorithm_version",
    "request_id",
    "trip_id",
    "input_state_version",
    "generation_id",
    "status",
    "best_schedule_draft",
    "best_cost_draft",
    "final_validation",
    "remaining_issue_ids",
    "strict_ready",
    "generated_at"
  ],
  "title": "ItineraryRepairResult",
  "type": "object",
  "x-travel-itinerary-repair-result": true
}
