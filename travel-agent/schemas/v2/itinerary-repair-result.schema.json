            "$ref": "#/$defs/ExcludedCostKind"
          },
          "title": "Excluded Costs",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "input_state_version": {
          "title": "Input State Version",
          "type": "integer"
        },
        "known_total_per_person": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftAmountRange"
