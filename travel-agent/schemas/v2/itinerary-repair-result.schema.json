        "service_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Date"
        },
        "severity": {
          "$ref": "#/$defs/ValidationSeverity"
