          "title": "Lodging Share Divisor",
          "type": "integer"
        },
        "party_size": {
          "title": "Party Size",
          "type": "integer"
        },
        "per_person": {
          "title": "Per Person",
          "type": "boolean"
        },
        "pricing_note": {
          "maxLength": 500,
          "minLength": 1,
