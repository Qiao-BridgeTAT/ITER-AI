        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schedule_request_id": {
          "format": "uuid",
          "title": "Schedule Request Id",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "task_book_id": {
          "format": "uuid",
          "title": "Task Book Id",
          "type": "string"
