          "items": {
            "$ref": "#/$defs/DraftDailyCostEstimate"
          },
          "title": "Days",
          "type": "array"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "excluded_costs": {
          "default": [],
