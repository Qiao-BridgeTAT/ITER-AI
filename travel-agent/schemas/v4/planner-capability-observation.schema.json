{
  "$defs": {
    "CandidateEntityKind": {
      "enum": [
        "attraction",
        "restaurant",
        "activity"
      ],
      "title": "CandidateEntityKind",
      "type": "string"
    },
    "CandidateRef": {
      "additionalProperties": false,
      "description": "Revision-bound reference to one candidate in the current pool.",
      "properties": {
        "candidate_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_pool_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Pool Id",
          "type": "string"
        },
        "candidate_pool_revision": {
          "minimum": 1,
          "title": "Candidate Pool Revision",
          "type": "integer"
        },
        "canonical_entity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Entity Id",
          "type": "string"
        },
        "entity_kind": {
          "$ref": "#/$defs/CandidateEntityKind"
        },
        "kind": {
          "const": "candidate",
          "default": "candidate",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "candidate_pool_id",
        "candidate_pool_revision",
        "candidate_id",
        "entity_kind",
        "canonical_entity_id"
      ],
      "title": "CandidateRef",
      "type": "object"
    },
    "PlannerCapability": {
      "enum": [
        "candidate_recall",
        "place_facts",
        "opening_hours",
        "ticket_availability",
        "weather_forecast",
        "spatial_routes",
        "hotel_search",
        "hotel_offer_refresh"
      ],
      "title": "PlannerCapability",
      "type": "string"
    },
    "PlannerScope": {
      "additionalProperties": false,
      "description": "Optimistic-concurrency scope shared by one Planner decision round.",
      "properties": {
        "generation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Generation Id",
          "type": "string"
        },
        "protocol_version": {
          "const": "v4",
          "default": "v4",
          "title": "Protocol Version",
          "type": "string"
        },
        "task_book_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Book Id",
          "type": "string"
        },
        "task_book_state_version": {
          "minimum": 0,
          "title": "Task Book State Version",
          "type": "integer"
        },
        "task_book_version": {
          "minimum": 1,
          "title": "Task Book Version",
          "type": "integer"
        },
        "trip_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Trip Id",
          "type": "string"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "trip_id",
        "generation_id",
        "task_book_id",
        "task_book_version",
        "task_book_state_version",
        "workspace_revision"
      ],
      "title": "PlannerScope",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v4/planner-capability-observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Receipt binds a typed request to normalized facts held in the workspace.",
  "properties": {
    "artifact_reference_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Artifact Reference Ids",
      "type": "array"
    },
    "candidate_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidateRef"
      },
      "title": "Candidate Refs",
      "type": "array"
    },
    "capability": {
      "$ref": "#/$defs/PlannerCapability"
    },
    "fact_reference_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Fact Reference Ids",
      "type": "array"
    },
    "observation_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Observation Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "reason_summary": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason Summary",
      "type": "string"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Request Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/PlannerScope"
    },
    "service_dates": {
      "default": [],
      "items": {
        "format": "date",
        "type": "string"
      },
      "title": "Service Dates",
      "type": "array"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "invalid_request"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "scope",
    "request_id",
    "capability",
    "status",
    "reason_summary",
    "observed_at"
  ],
  "title": "PlannerCapabilityObservation",
  "type": "object"
}
