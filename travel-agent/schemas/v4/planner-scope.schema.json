{
  "$id": "https://travel-agent.local/schemas/v4/planner-scope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Optimistic-concurrency scope shared by one Planner decision round.",
  "properties": {
    "generation_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Generation Id",
      "type": "string"
    },
    "protocol_version": {
      "const": "v4",
      "default": "v4",
      "title": "Protocol Version",
      "type": "string"
    },
    "task_book_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Task Book Id",
      "type": "string"
    },
    "task_book_state_version": {
      "minimum": 0,
      "title": "Task Book State Version",
      "type": "integer"
    },
    "task_book_version": {
      "minimum": 1,
      "title": "Task Book Version",
      "type": "integer"
    },
    "trip_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Trip Id",
      "type": "string"
    },
    "workspace_revision": {
      "minimum": 0,
      "title": "Workspace Revision",
      "type": "integer"
    }
  },
  "required": [
    "trip_id",
    "generation_id",
    "task_book_id",
    "task_book_version",
    "task_book_state_version",
    "workspace_revision"
  ],
  "title": "PlannerScope",
  "type": "object"
}
