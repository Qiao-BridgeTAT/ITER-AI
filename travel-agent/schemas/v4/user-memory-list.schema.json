{
  "$defs": {
    "UserMemoryView": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "preference",
            "feedback"
          ],
          "title": "Kind",
          "type": "string"
        },
        "memory_id": {
          "format": "uuid",
          "title": "Memory Id",
          "type": "string"
        },
        "source_message_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Message Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "trip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trip Id"
        }
      },
      "required": [
        "memory_id",
        "kind",
        "text",
        "created_at"
      ],
      "title": "UserMemoryView",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v4/user-memory-list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "memories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UserMemoryView"
      },
      "title": "Memories",
      "type": "array"
    }
  },
  "title": "UserMemoryList",
  "type": "object"
}
