{
  "$defs": {
    "AskUserReasonCode": {
      "enum": [
        "incompatible_strong_commitments",
        "fixed_booking_conflict",
        "permission_to_relax_constraint",
        "material_tradeoff_outside_delegation",
        "missing_user_owned_booking_detail",
        "revision_budget_exhausted"
      ],
      "title": "AskUserReasonCode",
      "type": "string"
    },
    "InteractionStatus": {
      "enum": [
        "active",
        "answered",
        "superseded",
        "expired"
      ],
      "title": "InteractionStatus",
      "type": "string"
    },
    "PlannerInteractionOption": {
      "additionalProperties": false,
      "properties": {
        "affected_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Refs",
          "type": "array"
        },
        "option_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Id",
          "type": "string"
        },
        "semantic_action": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Semantic Action",
          "type": "string"
        },
        "verified_impact_summary": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Verified Impact Summary",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "semantic_action",
        "affected_refs",
        "verified_impact_summary"
      ],
      "title": "PlannerInteractionOption",
      "type": "object"
    },
    "PlannerScope": {
      "additionalProperties": false,
      "description": "Optimistic-concurrency scope shared by one Planner decision round.",
      "properties": {
        "generation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Generation Id",
          "type": "string"
        },
        "protocol_version": {
          "const": "v4",
          "default": "v4",
          "title": "Protocol Version",
          "type": "string"
        },
        "task_book_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Book Id",
          "type": "string"
        },
        "task_book_state_version": {
          "minimum": 0,
          "title": "Task Book State Version",
          "type": "integer"
        },
        "task_book_version": {
          "minimum": 1,
          "title": "Task Book Version",
          "type": "integer"
        },
        "trip_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Trip Id",
          "type": "string"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "trip_id",
        "generation_id",
        "task_book_id",
        "task_book_version",
        "task_book_state_version",
        "workspace_revision"
      ],
      "title": "PlannerScope",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v4/planner-interaction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_dates": {
      "default": [],
      "items": {
        "format": "date",
        "type": "string"
      },
      "title": "Affected Dates",
      "type": "array"
    },
    "allow_free_text": {
      "title": "Allow Free Text",
      "type": "boolean"
    },
    "based_on_workspace_revision": {
      "minimum": 0,
      "title": "Based On Workspace Revision",
      "type": "integer"
    },
    "decision_scope": {
      "enum": [
        "global",
        "date",
        "item",
        "hotel"
      ],
      "title": "Decision Scope",
      "type": "string"
    },
    "interaction_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Interaction Id",
      "type": "string"
    },
    "issue_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Issue Ids",
      "type": "array"
    },
    "option_contracts": {
      "items": {
        "$ref": "#/$defs/PlannerInteractionOption"
      },
      "minItems": 1,
      "title": "Option Contracts",
      "type": "array"
    },
    "question": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    },
    "reason_code": {
      "$ref": "#/$defs/AskUserReasonCode"
    },
    "resume_token": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Resume Token",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/PlannerScope"
    },
    "status": {
      "$ref": "#/$defs/InteractionStatus"
    }
  },
  "required": [
    "interaction_id",
    "scope",
    "reason_code",
    "issue_ids",
    "decision_scope",
    "option_contracts",
    "allow_free_text",
    "based_on_workspace_revision",
    "resume_token",
    "status"
  ],
  "title": "PlannerInteraction",
  "type": "object"
}
