        "unresolved_reason": {
          "anyOf": [
            {
              "enum": [
                "provider_unavailable",
                "no_verified_hotel",
                "not_queried",
                "no_results",
                "query_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved Reason"
        }
      },
      "required": [
        "mode"
      ],
      "title": "LodgingBaseline",
      "type": "object"
    },
