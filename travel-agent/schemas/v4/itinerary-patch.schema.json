        "hotel_observation_id",
        "offer_id",
        "property_id",
        "inventory_snapshot_id"
      ],
      "title": "HotelOfferRef",
      "type": "object"
    },
    "InsertItemOperation": {
      "additionalProperties": false,
      "properties": {
        "after_item_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
