              "type": "null"
            }
          ],
          "default": null,
          "title": "After Item Id"
        },
        "at_end": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At End"
        },
        "authority_item_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Authority Item Refs",
          "type": "array"
        },
        "before_item_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Item Id"
        },
        "item": {
          "$ref": "#/$defs/DraftItem"
        },
        "operation": {
          "const": "insert_item",
          "default": "insert_item",
          "title": "Operation",
          "type": "string"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        }
      },
      "required": [
        "service_date",
        "item",
        "authority_item_refs"
      ],
      "title": "InsertItemOperation",
      "type": "object"
    },
    "LodgingBaseline": {
      "additionalProperties": false,
      "properties": {
        "fixed_commitment_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixedCommitmentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "enum": [
            "not_applicable",
            "fixed",
            "selected_offer",
            "unresolved"
          ],
          "title": "Mode",
          "type": "string"
        },
        "selected_offer_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/HotelOfferRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
