{
  "$defs": {
    "CandidateEntityKind": {
      "enum": [
        "attraction",
        "restaurant",
        "activity"
      ],
      "title": "CandidateEntityKind",
      "type": "string"
    },
    "CandidateRef": {
      "additionalProperties": false,
      "description": "Revision-bound reference to one candidate in the current pool.",
      "properties": {
        "candidate_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_pool_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Pool Id",
          "type": "string"
        },
        "candidate_pool_revision": {
          "minimum": 1,
          "title": "Candidate Pool Revision",
          "type": "integer"
        },
        "canonical_entity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Entity Id",
          "type": "string"
        },
        "entity_kind": {
          "$ref": "#/$defs/CandidateEntityKind"
        },
        "kind": {
          "const": "candidate",
          "default": "candidate",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "candidate_pool_id",
        "candidate_pool_revision",
        "candidate_id",
        "entity_kind",
        "canonical_entity_id"
      ],
      "title": "CandidateRef",
      "type": "object"
    },
    "CrossClusterReasonCode": {
      "enum": [
        "reservation_or_fixed_commitment",
        "date_specific_availability",
        "strong_user_intent",
        "lodging_or_transport_anchor",
        "verified_global_route_improvement"
      ],
      "title": "CrossClusterReasonCode",
      "type": "string"
    },
    "CrossClusterSegment": {
      "additionalProperties": false,
      "properties": {
        "comparison_observation_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Observation Ref"
        },
        "covered_item_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Covered Item Ids",
          "type": "array"
        },
        "expected_route_cost": {
          "$ref": "#/$defs/ExpectedRouteCost"
        },
        "from_cluster_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "From Cluster Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/CrossClusterReasonCode"
        },
        "route_edge_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Route Edge Ids",
          "type": "array"
        },
        "supporting_intent_or_fact_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Intent Or Fact Refs",
          "type": "array"
        },
        "to_cluster_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "To Cluster Id",
          "type": "string"
        }
      },
      "required": [
        "from_cluster_id",
        "to_cluster_id",
        "covered_item_ids",
        "reason_code",
        "supporting_intent_or_fact_refs",
        "route_edge_ids",
        "expected_route_cost"
      ],
      "title": "CrossClusterSegment",
      "type": "object"
    },
    "DraftItem": {
      "additionalProperties": false,
      "properties": {
        "cluster_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster Id"
        },
        "commitment_level": {
          "enum": [
            "immutable",
            "strong",
            "soft",
            "filler",
            "neutral"
          ],
          "title": "Commitment Level",
          "type": "string"
        },
        "draft_item_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Draft Item Id",
          "type": "string"
        },
        "duration_preference": {
          "anyOf": [
            {
              "enum": [
                "short",
                "normal",
                "extended"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Preference"
        },
        "expected_window": {
          "$ref": "#/$defs/ExpectedWindow"
        },
        "item_kind": {
          "enum": [
            "visit",
            "dining",
            "fixed_event",
            "arrival",
            "departure"
          ],
          "title": "Item Kind",
          "type": "string"
        },
        "meal_slot": {
          "anyOf": [
            {
              "enum": [
                "breakfast",
                "lunch",
                "dinner",
                "snack"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meal Slot"
        },
        "object_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/CandidateRef"
            },
            {
              "$ref": "#/$defs/FixedCommitmentRef"
            }
          ],
          "title": "Object Ref",
          "type": "object"
        },
        "onsite_lunch": {
          "default": false,
          "title": "Onsite Lunch",
          "type": "boolean"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "draft_item_id",
        "position",
        "item_kind",
        "object_ref",
        "expected_window",
        "commitment_level"
      ],
      "title": "DraftItem",
      "type": "object"
    },
    "ExpectedRouteCost": {
      "additionalProperties": false,
      "properties": {
        "distance_meters": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Meters"
        },
        "duration_minutes": {
          "maximum": 1440,
          "minimum": 0,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "transfer_count": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transfer Count"
        }
      },
      "required": [
        "duration_minutes"
      ],
      "title": "ExpectedRouteCost",
      "type": "object"
    },
    "ExpectedWindow": {
      "additionalProperties": false,
      "properties": {
        "earliest": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earliest"
        },
        "latest": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest"
        },
        "part_of_day": {
          "enum": [
            "morning",
            "midday",
            "afternoon",
            "evening",
            "anytime"
          ],
          "title": "Part Of Day",
          "type": "string"
        }
      },
      "required": [
        "part_of_day"
      ],
      "title": "ExpectedWindow",
      "type": "object"
    },
    "FixedCommitmentRef": {
      "additionalProperties": false,
      "description": "Reference to a user-owned immutable commitment in the task book.",
      "properties": {
        "commitment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Commitment Id",
          "type": "string"
        },
        "commitment_kind": {
          "enum": [
            "reservation",
            "arrival",
            "departure",
            "named_hotel",
            "existing_booking"
          ],
          "title": "Commitment Kind",
          "type": "string"
        },
        "kind": {
          "const": "fixed_commitment",
          "default": "fixed_commitment",
          "title": "Kind",
          "type": "string"
        },
        "task_book_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Book Id",
          "type": "string"
        },
        "task_book_version": {
          "minimum": 1,
          "title": "Task Book Version",
          "type": "integer"
        }
      },
      "required": [
        "task_book_id",
        "task_book_version",
        "commitment_id",
        "commitment_kind"
      ],
      "title": "FixedCommitmentRef",
      "type": "object"
    },
    "HotelOfferRef": {
      "additionalProperties": false,
      "description": "Inventory-snapshot-bound reference to a normalized hotel offer.",
      "properties": {
        "hotel_observation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Hotel Observation Id",
