        "offer_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Offer Id",
          "type": "string"
        },
        "property_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Property Id",
          "type": "string"
