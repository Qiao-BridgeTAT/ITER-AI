  "$id": "https://travel-agent.local/schemas/v4/itinerary-patch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Authorized, domain-specific patch; deliberately not RFC 6902.",
  "properties": {
    "authority": {
      "oneOf": [
        {
          "$ref": "#/$defs/ValidationIssuePatchAuthority"
        },
        {
          "$ref": "#/$defs/PlanChangeRequestPatchAuthority"
        },
        {
          "$ref": "#/$defs/PlannerInteractionAnswerPatchAuthority"
        }
      ],
      "title": "Authority",
      "type": "object"
    },
    "base_content_digest": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "\\S",
      "title": "Base Content Digest",
      "type": "string"
    },
    "base_draft_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Base Draft Id",
      "type": "string"
    },
    "base_draft_revision": {
      "minimum": 1,
      "title": "Base Draft Revision",
      "type": "integer"
    },
    "declared_affected_dates": {
      "items": {
        "format": "date",
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Declared Affected Dates",
      "type": "array"
    },
    "operations": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/InsertItemOperation"
          },
          {
            "$ref": "#/$defs/RemoveItemOperation"
          },
          {
            "$ref": "#/$defs/ReplaceItemOperation"
          },
          {
            "$ref": "#/$defs/MoveItemOperation"
          },
          {
            "$ref": "#/$defs/ReorderItemOperation"
          },
          {
            "$ref": "#/$defs/SetPreferredWindowOperation"
          },
          {
            "$ref": "#/$defs/SetTransportPreferenceOperation"
          },
          {
            "$ref": "#/$defs/SetPrimaryClusterOperation"
          },
          {
            "$ref": "#/$defs/SetCrossClusterSegmentOperation"
          },
          {
            "$ref": "#/$defs/SetHotelBaselineOperation"
          },
          {
            "$ref": "#/$defs/SetDiscardRankOperation"
          }
        ],
        "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "patch_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Patch Id",
      "type": "string"
    },
    "reason_summary": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason Summary",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/PlannerScope"
    }
  },
  "required": [
    "patch_id",
    "scope",
    "base_draft_id",
    "base_draft_revision",
    "base_content_digest",
    "authority",
    "operations",
    "declared_affected_dates",
    "reason_summary"
  ],
  "title": "ItineraryPatch",
  "type": "object"
}
