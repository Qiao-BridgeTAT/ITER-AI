{
  "$defs": {
    "CandidateEntityKind": {
      "enum": [
        "attraction",
        "restaurant",
        "activity"
      ],
      "title": "CandidateEntityKind",
      "type": "string"
    },
    "CandidateRef": {
      "additionalProperties": false,
      "description": "Revision-bound reference to one candidate in the current pool.",
      "properties": {
        "candidate_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_pool_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Candidate Pool Id",
          "type": "string"
        },
        "candidate_pool_revision": {
          "minimum": 1,
          "title": "Candidate Pool Revision",
          "type": "integer"
        },
        "canonical_entity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Entity Id",
          "type": "string"
        },
        "entity_kind": {
          "$ref": "#/$defs/CandidateEntityKind"
        },
        "kind": {
          "const": "candidate",
          "default": "candidate",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "candidate_pool_id",
        "candidate_pool_revision",
        "candidate_id",
        "entity_kind",
        "canonical_entity_id"
      ],
      "title": "CandidateRef",
      "type": "object"
    },
    "CrossClusterReasonCode": {
      "enum": [
        "reservation_or_fixed_commitment",
        "date_specific_availability",
        "strong_user_intent",
        "lodging_or_transport_anchor",
        "verified_global_route_improvement"
      ],
      "title": "CrossClusterReasonCode",
      "type": "string"
    },
    "DayGrouping": {
      "additionalProperties": false,
      "properties": {
        "cross_cluster_segments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DayGroupingCrossClusterSegment"
          },
          "title": "Cross Cluster Segments",
          "type": "array"
        },
        "ordered_candidate_refs": {
          "items": {
            "$ref": "#/$defs/CandidateRef"
          },
          "title": "Ordered Candidate Refs",
          "type": "array"
        },
        "primary_cluster_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Primary Cluster Id",
          "type": "string"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        }
      },
      "required": [
        "service_date",
        "primary_cluster_id",
        "ordered_candidate_refs"
      ],
      "title": "DayGrouping",
      "type": "object"
    },
    "DayGroupingCrossClusterSegment": {
      "additionalProperties": false,
      "properties": {
        "candidate_refs": {
          "items": {
            "$ref": "#/$defs/CandidateRef"
          },
          "minItems": 1,
          "title": "Candidate Refs",
          "type": "array"
        },
        "comparison_observation_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Observation Ref"
        },
        "from_cluster_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "From Cluster Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/CrossClusterReasonCode"
        },
        "route_edge_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Route Edge Ids",
          "type": "array"
        },
        "supporting_intent_or_fact_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Intent Or Fact Refs",
          "type": "array"
        },
        "to_cluster_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "To Cluster Id",
          "type": "string"
        }
      },
      "required": [
        "from_cluster_id",
        "to_cluster_id",
        "candidate_refs",
        "reason_code",
        "supporting_intent_or_fact_refs",
        "route_edge_ids"
      ],
      "title": "DayGroupingCrossClusterSegment",
      "type": "object"
    },
    "PlannerScope": {
      "additionalProperties": false,
      "description": "Optimistic-concurrency scope shared by one Planner decision round.",
      "properties": {
        "generation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Generation Id",
          "type": "string"
        },
        "protocol_version": {
          "const": "v4",
          "default": "v4",
          "title": "Protocol Version",
          "type": "string"
        },
        "task_book_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Book Id",
          "type": "string"
        },
        "task_book_state_version": {
          "minimum": 0,
          "title": "Task Book State Version",
          "type": "integer"
        },
        "task_book_version": {
          "minimum": 1,
          "title": "Task Book Version",
          "type": "integer"
        },
        "trip_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Trip Id",
          "type": "string"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "trip_id",
        "generation_id",
        "task_book_id",
        "task_book_version",
        "task_book_state_version",
        "workspace_revision"
      ],
      "title": "PlannerScope",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v4/day-grouping-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_pool_revision": {
      "minimum": 1,
      "title": "Candidate Pool Revision",
      "type": "integer"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/DayGrouping"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Days",
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/PlannerScope"
    },
    "spatial_observation_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Spatial Observation Id",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "candidate_pool_revision",
    "spatial_observation_id",
    "days"
  ],
  "title": "DayGroupingDecision",
  "type": "object"
}
