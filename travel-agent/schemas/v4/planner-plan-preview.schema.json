{
  "$defs": {
    "CnyAmountRange": {
      "additionalProperties": false,
      "description": "A closed CNY range represented in integer fen.",
      "properties": {
        "currency": {
          "default": "CNY",
          "pattern": "^CNY$",
          "title": "Currency",
          "type": "string"
        },
        "maximum_fen": {
          "minimum": 0,
          "title": "Maximum Fen",
          "type": "integer"
        },
        "minimum_fen": {
          "minimum": 0,
          "title": "Minimum Fen",
          "type": "integer"
        }
      },
      "required": [
        "minimum_fen",
        "maximum_fen"
      ],
      "title": "CnyAmountRange",
      "type": "object"
    },
    "DiningDisplayFacts": {
      "additionalProperties": false,
      "properties": {
        "average_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/CnyAmountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cuisine": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuisine"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "rating": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "source_name": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Name",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "source_name",
        "observed_at"
      ],
      "title": "DiningDisplayFacts",
      "type": "object"
    },
    "PlannerPlacePreview": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dining_details": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiningDisplayFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_source_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Source Ref"
        },
        "image_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        }
      },
      "required": [
        "place_id"
      ],
      "title": "PlannerPlacePreview",
      "type": "object"
    },
    "PlannerWeatherEvidence": {
      "additionalProperties": false,
      "properties": {
        "condition_day": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Day"
        },
        "condition_night": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Night"
        },
        "fact_reference_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fact Reference Id",
          "type": "string"
        },
        "forecast_kind": {
          "default": "forecast",
          "enum": [
            "forecast",
            "outlook"
          ],
          "title": "Forecast Kind",
          "type": "string"
        },
        "high_celsius": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High Celsius"
        },
        "low_celsius": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low Celsius"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "service_date": {
          "format": "date",
          "title": "Service Date",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Name"
        }
      },
      "required": [
        "service_date",
        "observed_at",
        "fact_reference_id"
      ],
      "title": "PlannerWeatherEvidence",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v4/planner-plan-preview.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "places": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlannerPlacePreview"
      },
      "maxItems": 100,
      "title": "Places",
      "type": "array"
    },
    "plan_version_id": {
      "format": "uuid",
      "title": "Plan Version Id",
      "type": "string"
    },
    "trip_id": {
      "format": "uuid",
      "title": "Trip Id",
      "type": "string"
    },
    "weather_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlannerWeatherEvidence"
      },
      "maxItems": 5,
      "title": "Weather Evidence",
      "type": "array"
    }
  },
  "required": [
    "trip_id",
    "plan_version_id"
  ],
  "title": "PlannerPlanPreview",
  "type": "object"
}
