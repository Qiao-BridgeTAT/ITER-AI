      "additionalProperties": false,
      "properties": {
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "event_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "const": "agent.status",
          "title": "Event Type",
          "type": "string"
        },
        "generation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Generation Id",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "protocol_version": {
          "const": "v4",
          "default": "v4",
          "title": "Protocol Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "status_code": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Status Code",
          "type": "string"
        },
        "trip_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Trip Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "trip_id",
        "turn_id",
        "generation_id",
        "sequence",
        "emitted_at",
        "status_code",
        "message"
      ],
      "title": "AgentStatusEvent",
      "type": "object"
    },
