{
  "$defs": {
    "AttractionDirection": {
      "additionalProperties": false,
      "properties": {
        "delegated_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DelegatedScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exclusions": {
          "items": {
            "$ref": "#/$defs/TaskBookEntityIntent"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "if_convenient": {
          "items": {
            "$ref": "#/$defs/TaskBookEntityIntent"
          },
          "title": "If Convenient",
          "type": "array"
        },
        "must_visit": {
          "items": {
            "$ref": "#/$defs/TaskBookEntityIntent"
          },
          "title": "Must Visit",
          "type": "array"
        },
        "preferences": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Preferences",
          "type": "array"
        },
        "wanted": {
          "items": {
            "$ref": "#/$defs/TaskBookEntityIntent"
          },
          "title": "Wanted",
          "type": "array"
        }
      },
      "title": "AttractionDirection",
      "type": "object"
    },
    "AttractionDisposition": {
      "enum": [
        "must",
        "want",
        "if_convenient",
        "avoid"
      ],
      "title": "AttractionDisposition",
      "type": "string"
    },
    "BookingReference": {
      "additionalProperties": false,
      "properties": {
        "booking_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Booking Id",
          "type": "string"
        },
        "booking_kind": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Booking Kind",
          "type": "string"
        },
        "canonical_entity_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Entity Id"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "source_operation_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Operation Refs",
          "type": "array"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "user_description": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "User Description",
          "type": "string"
        }
      },
      "required": [
        "booking_id",
        "booking_kind",
        "user_description",
        "source_operation_refs"
      ],
      "title": "BookingReference",
      "type": "object"
    },
    "CardGenerationRecovery": {
      "additionalProperties": false,
      "description": "A durable retry affordance, never a selectable card or semantic answer.",
      "properties": {
        "action": {
          "const": "retry_card",
          "default": "retry_card",
          "title": "Action",
          "type": "string"
        },
        "failure_code": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Failure Code",
          "type": "string"
        }
      },
      "required": [
        "failure_code"
      ],
      "title": "CardGenerationRecovery",
      "type": "object"
    },
    "CompletionMode": {
      "enum": [
        "selected",
        "explicitly_none",
        "existing_booking",
        "delegated",
        "not_applicable"
      ],
      "title": "CompletionMode",
      "type": "string"
    },
    "CoverageStatus": {
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "reopened",
        "not_applicable"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "DecisionAuditPointer": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Action",
          "type": "string"
        },
        "based_on_state_version": {
          "minimum": 0,
          "title": "Based On State Version",
          "type": "integer"
        },
        "decision_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Decision Id",
          "type": "string"
        },
        "status": {
          "pattern": "^(proposed|executed|rejected|superseded)$",
          "title": "Status",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "decision_id",
        "action",
        "based_on_state_version",
        "status"
      ],
      "title": "DecisionAuditPointer",
      "type": "object"
    },
    "DelegatedScope": {
      "additionalProperties": false,
      "properties": {
        "boundary_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Boundary Refs",
          "type": "array"
        },
        "delegated_targets": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Delegated Targets",
          "type": "array"
        },
        "domain": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Domain",
          "type": "string"
        },
        "source_operation_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Operation Refs",
          "type": "array"
        }
      },
      "required": [
        "domain",
        "delegated_targets",
        "source_operation_refs"
      ],
      "title": "DelegatedScope",
      "type": "object"
    },
    "DestinationAndDates": {
      "additionalProperties": false,
      "properties": {
        "destination_canonical_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Canonical Id"
        },
        "destination_name": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Destination Name",
          "type": "string"
        },
        "duration_days": {
          "maximum": 5,
          "minimum": 1,
          "title": "Duration Days",
          "type": "integer"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "source_evidence_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Refs",
          "type": "array"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "destination_name",
        "start_date",
        "end_date",
        "duration_days",
        "source_evidence_refs"
      ],
      "title": "DestinationAndDates",
      "type": "object"
    },
    "DiningDirection": {
      "additionalProperties": false,
      "properties": {
        "delegated_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DelegatedScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "destination_restaurants": {
          "items": {
            "$ref": "#/$defs/TaskBookEntityIntent"
          },
          "title": "Destination Restaurants",
          "type": "array"
        },
        "excluded_restaurants": {
          "items": {
            "$ref": "#/$defs/TaskBookEntityIntent"
          },
          "title": "Excluded Restaurants",
          "type": "array"
        },
        "hard_requirements": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Hard Requirements",
          "type": "array"
        },
        "if_convenient_restaurants": {
          "items": {
            "$ref": "#/$defs/TaskBookEntityIntent"
          },
          "title": "If Convenient Restaurants",
          "type": "array"
        },
        "preferences": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Preferences",
          "type": "array"
        }
      },
      "title": "DiningDirection",
      "type": "object"
    },
    "DiningDisposition": {
      "enum": [
        "destination",
        "if_convenient",
        "avoid"
      ],
      "title": "DiningDisposition",
      "type": "string"
    },
    "DiscoverySection": {
      "enum": [
        "other",
        "attraction_preference",
        "attraction_specific",
        "dining_preference",
        "dining_specific",
        "lodging_area_preference",
        "lodging_class_preference",
        "final_supplement",
        "task_book_review"
      ],
      "title": "DiscoverySection",
      "type": "string"
    },
    "EvidenceBackedText": {
      "additionalProperties": false,
      "properties": {
        "source_evidence_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Refs",
          "type": "array"
        },
        "value": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source_evidence_refs"
      ],
      "title": "EvidenceBackedText",
      "type": "object"
    },
    "InteractionStatus": {
      "enum": [
        "active",
        "answered",
        "superseded",
        "expired"
      ],
      "title": "InteractionStatus",
      "type": "string"
    },
    "LodgingDirection": {
      "additionalProperties": false,
      "properties": {
        "area_preferences": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Area Preferences",
          "type": "array"
        },
        "delegated_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DelegatedScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "existing_booking": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookingReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facility_requirements": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Facility Requirements",
          "type": "array"
        },
        "hotel_quality_tier": {
          "anyOf": [
            {
              "pattern": "^(economy|comfort|upscale|luxury)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hotel Quality Tier"
        },
        "hotel_quality_tiers": {
          "items": {
            "enum": [
              "economy",
              "comfort",
              "upscale",
              "luxury"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Hotel Quality Tiers",
          "type": "array"
        },
        "nightly_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "not_applicable": {
          "default": false,
          "title": "Not Applicable",
          "type": "boolean"
        },
        "property_type_preferences": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Property Type Preferences",
          "type": "array"
        },
        "search_examples": {
          "items": {
            "$ref": "#/$defs/LodgingExample"
          },
          "maxItems": 7,
          "title": "Search Examples",
          "type": "array"
        }
      },
      "title": "LodgingDirection",
      "type": "object"
    },
    "LodgingExample": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 2,
          "title": "Name",
          "type": "string"
        },
        "search_keyword": {
          "maxLength": 120,
          "minLength": 2,
          "title": "Search Keyword",
          "type": "string"
        }
      },
      "required": [
        "name",
        "search_keyword"
      ],
      "title": "LodgingExample",
      "type": "object"
    },
    "MoneyRange": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "default": "CNY",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "maximum_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Minor"
        },
        "minimum_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Minor"
        }
      },
      "title": "MoneyRange",
      "type": "object"
    },
    "PaceAndTransport": {
      "additionalProperties": false,
      "properties": {
        "pace_preferences": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Pace Preferences",
          "type": "array"
        },
        "transport_preferences": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Transport Preferences",
          "type": "array"
        }
      },
      "title": "PaceAndTransport",
      "type": "object"
    },
    "PendingInteraction": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "recovery": {
                "type": "object"
              }
            },
            "required": [
              "recovery"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "free_text_question"
              },
              "option_refs": {
                "maxItems": 0,
                "type": "array"
              },
              "section": {
                "enum": [
                  "attraction_preference",
                  "attraction_specific",
                  "dining_preference",
                  "dining_specific",
                  "lodging_area_preference",
                  "lodging_class_preference"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "based_on_state_version": {
          "minimum": 0,
          "title": "Based On State Version",
          "type": "integer"
        },
        "dependency_fingerprint": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dependency Fingerprint",
          "type": "string"
        },
        "interaction_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Interaction Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PendingInteractionKind"
        },
        "option_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Option Refs",
          "type": "array"
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/CardGenerationRecovery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "section": {
          "$ref": "#/$defs/DiscoverySection"
        },
        "status": {
          "$ref": "#/$defs/InteractionStatus",
          "default": "active"
        },
        "target_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "interaction_id",
        "kind",
        "section",
        "target_ids",
        "based_on_state_version",
        "dependency_fingerprint"
      ],
      "title": "PendingInteraction",
      "type": "object"
    },
    "PendingInteractionKind": {
      "enum": [
        "preference_card",
        "specific_card",
        "free_text_question",
        "confirmation"
      ],
      "title": "PendingInteractionKind",
      "type": "string"
    },
    "SectionCoverage": {
      "additionalProperties": false,
      "properties": {
        "blocking_conflict_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Blocking Conflict Ids",
          "type": "array"
        },
        "completed_at_state_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At State Version"
        },
        "completion_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "covered_targets": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Covered Targets",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "required_targets": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Required Targets",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus",
          "default": "not_started"
        }
      },
      "title": "SectionCoverage",
      "type": "object"
    },
    "TaskBookCandidate": {
      "additionalProperties": false,
      "properties": {
        "based_on_state_version": {
          "minimum": 0,
          "title": "Based On State Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskBookStatus"
        },
        "task_book_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Book Id",
          "type": "string"
        },
        "unresolved_items": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Unresolved Items",
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/TaskBookV4"
        }
      },
      "required": [
        "task_book_id",
        "based_on_state_version",
        "status",
        "created_at",
        "value"
      ],
      "title": "TaskBookCandidate",
      "type": "object"
    },
    "TaskBookEntityIntent": {
      "additionalProperties": false,
      "properties": {
        "canonical_entity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Entity Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Display Name",
          "type": "string"
        },
        "disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttractionDisposition"
            },
            {
              "$ref": "#/$defs/DiningDisposition"
            }
          ],
          "title": "Disposition"
        },
        "facts_to_verify": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Facts To Verify",
          "type": "array"
        },
        "source_operation_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Operation Refs",
          "type": "array"
        }
      },
      "required": [
        "canonical_entity_id",
        "display_name",
        "disposition",
        "source_operation_refs"
      ],
      "title": "TaskBookEntityIntent",
      "type": "object"
    },
    "TaskBookStatus": {
      "enum": [
        "draft",
        "awaiting_confirmation",
        "confirmed",
        "superseded"
      ],
      "title": "TaskBookStatus",
      "type": "string"
    },
    "TaskBookV4": {
      "additionalProperties": false,
      "properties": {
        "attraction_direction": {
          "$ref": "#/$defs/AttractionDirection"
        },
        "based_on_state_version": {
          "minimum": 0,
          "title": "Based On State Version",
          "type": "integer"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "destination_and_dates": {
          "$ref": "#/$defs/DestinationAndDates"
        },
        "dining_direction": {
          "$ref": "#/$defs/DiningDirection"
        },
        "existing_bookings": {
          "items": {
            "$ref": "#/$defs/BookingReference"
          },
          "title": "Existing Bookings",
          "type": "array"
        },
        "hard_constraints": {
          "items": {
            "$ref": "#/$defs/EvidenceBackedText"
          },
          "title": "Hard Constraints",
          "type": "array"
        },
        "lodging_direction": {
          "$ref": "#/$defs/LodgingDirection"
        },
        "pace_and_transport": {
          "$ref": "#/$defs/PaceAndTransport"
        },
        "source_evidence_refs": {
          "items": {
            "maxLength": 200,
