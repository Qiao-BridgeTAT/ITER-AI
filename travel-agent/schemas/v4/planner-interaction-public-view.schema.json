{
  "$defs": {
    "AskUserReasonCode": {
      "enum": [
        "incompatible_strong_commitments",
        "fixed_booking_conflict",
        "permission_to_relax_constraint",
        "material_tradeoff_outside_delegation",
        "missing_user_owned_booking_detail",
        "revision_budget_exhausted"
      ],
      "title": "AskUserReasonCode",
      "type": "string"
    },
    "InteractionStatus": {
      "enum": [
        "active",
        "answered",
        "superseded",
        "expired"
      ],
      "title": "InteractionStatus",
      "type": "string"
    },
    "PlannerInteractionOption": {
      "additionalProperties": false,
      "properties": {
        "affected_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Refs",
          "type": "array"
        },
        "option_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Option Id",
          "type": "string"
        },
        "semantic_action": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Semantic Action",
          "type": "string"
        },
        "verified_impact_summary": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Verified Impact Summary",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "semantic_action",
        "affected_refs",
        "verified_impact_summary"
      ],
      "title": "PlannerInteractionOption",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v4/planner-interaction-public-view.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Only fields required to render and answer the current user decision.",
  "properties": {
    "interaction_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Interaction Id",
      "type": "string"
    },
    "option_contracts": {
      "items": {
        "$ref": "#/$defs/PlannerInteractionOption"
      },
      "minItems": 1,
      "title": "Option Contracts",
      "type": "array"
    },
    "question": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    },
    "reason_code": {
      "$ref": "#/$defs/AskUserReasonCode"
    },
    "resume_token": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Resume Token",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/InteractionStatus"
    }
  },
  "required": [
    "interaction_id",
    "reason_code",
    "option_contracts",
    "resume_token",
    "status"
  ],
  "title": "PlannerInteractionPublicView",
  "type": "object"
}
