{
  "$id": "https://travel-agent.local/schemas/v4/destination-and-dates.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "destination_canonical_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination Canonical Id"
    },
    "destination_name": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Destination Name",
      "type": "string"
    },
    "duration_days": {
      "maximum": 5,
      "minimum": 1,
      "title": "Duration Days",
      "type": "integer"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "source_evidence_refs": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Evidence Refs",
      "type": "array"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    }
  },
  "required": [
    "destination_name",
    "start_date",
    "end_date",
    "duration_days",
    "source_evidence_refs"
  ],
  "title": "DestinationAndDates",
  "type": "object"
}
