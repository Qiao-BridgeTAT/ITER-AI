{
  "$defs": {
    "Gcj02Coordinates": {
      "additionalProperties": false,
      "description": "Canonical coordinates used by every internal planning contract.",
      "properties": {
        "coord_system": {
          "const": "gcj_02",
          "title": "Coord System",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "coord_system"
      ],
      "title": "Gcj02Coordinates",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v4/planner-hotel-location-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "address": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Address"
    },
    "coordinates": {
      "$ref": "#/$defs/Gcj02Coordinates"
    },
    "display_name": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "fact_reference_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Fact Reference Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "property_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Property Id",
      "type": "string"
    },
    "provider_entity_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Provider Entity Id",
      "type": "string"
    },
    "rating": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rating"
    }
  },
  "required": [
    "property_id",
    "provider_entity_id",
    "coordinates",
    "fact_reference_id",
    "observed_at"
  ],
  "title": "PlannerHotelLocationEvidence",
  "type": "object"
}
