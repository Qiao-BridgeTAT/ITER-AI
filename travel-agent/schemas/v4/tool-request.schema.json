{
  "$defs": {
    "HotelBookingFactsRequest": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "hotel_booking_facts",
          "title": "Capability",
          "type": "string"
        },
        "city": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "City",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "purpose": {
          "$ref": "#/$defs/ToolRequestPurpose"
        },
        "request_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Request Id",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "user_booking_ref": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "User Booking Ref",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "purpose",
        "required",
        "capability",
        "user_booking_ref",
        "city"
      ],
      "title": "HotelBookingFactsRequest",
      "type": "object"
    },
