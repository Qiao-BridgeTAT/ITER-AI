    "SpatialRoutesRequest": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "spatial_routes",
          "title": "Capability",
          "type": "string"
        },
        "departure_at_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure At Ref"
        },
        "depends_on": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "destination_ref": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Destination Ref",
          "type": "string"
        },
        "origin_ref": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Origin Ref",
          "type": "string"
