        "request_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Request Id",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "transport_modes": {
          "items": {
            "enum": [
              "public_transit",
              "taxi",
              "walking",
              "driving"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Transport Modes",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "purpose",
        "required",
        "capability",
        "origin_ref",
        "destination_ref",
        "transport_modes"
      ],
      "title": "SpatialRoutesRequest",
      "type": "object"
