          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Canonical Entity Ids",
          "type": "array"
        },
        "capability": {
          "const": "opening_hours",
          "title": "Capability",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "purpose": {
          "$ref": "#/$defs/ToolRequestPurpose"
        },
        "request_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Request Id",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "service_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Service Dates",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "purpose",
        "required",
        "capability",
        "canonical_entity_ids",
        "service_dates"
      ],
      "title": "OpeningHoursRequest",
      "type": "object"
    },
