{
  "$id": "https://travel-agent.local/schemas/v4/create-user-memory.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "explicitly_confirmed": {
      "const": true,
      "title": "Explicitly Confirmed",
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "preference",
        "feedback"
      ],
      "title": "Kind",
      "type": "string"
    },
    "source_message_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Message Id"
    },
    "text": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "trip_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trip Id"
    }
  },
  "required": [
    "kind",
    "text",
    "explicitly_confirmed"
  ],
  "title": "CreateUserMemory",
  "type": "object"
}
