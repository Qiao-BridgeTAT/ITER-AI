{
  "$defs": {
    "AlternativeHotelRecommendation": {
      "additionalProperties": false,
      "properties": {
        "difference_from_best": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Difference From Best",
          "type": "string"
        },
        "hotel_offer_ref": {
          "$ref": "#/$defs/HotelOfferRef"
        },
        "role": {
          "enum": [
            "better_value",
            "alternative_location_or_experience"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "hotel_offer_ref",
        "difference_from_best"
      ],
      "title": "AlternativeHotelRecommendation",
      "type": "object"
    },
    "BestHotelRecommendation": {
      "additionalProperties": false,
      "properties": {
        "area_reason": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Area Reason",
          "type": "string"
        },
        "hotel_offer_ref": {
          "$ref": "#/$defs/HotelOfferRef"
        },
        "main_tradeoff": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Main Tradeoff",
          "type": "string"
        },
        "quality_and_price_fit": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quality And Price Fit",
          "type": "string"
        },
        "role": {
          "const": "best",
          "default": "best",
          "title": "Role",
          "type": "string"
        },
        "route_fit": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Route Fit",
          "type": "string"
        }
      },
      "required": [
        "hotel_offer_ref",
        "area_reason",
        "route_fit",
        "quality_and_price_fit",
        "main_tradeoff"
      ],
      "title": "BestHotelRecommendation",
      "type": "object"
    },
    "HotelOfferRef": {
      "additionalProperties": false,
      "description": "Inventory-snapshot-bound reference to a normalized hotel offer.",
      "properties": {
        "hotel_observation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Hotel Observation Id",
          "type": "string"
        },
        "inventory_snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Inventory Snapshot Id",
          "type": "string"
        },
        "kind": {
          "const": "hotel_offer",
          "default": "hotel_offer",
          "title": "Kind",
          "type": "string"
        },
        "offer_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Offer Id",
          "type": "string"
        },
        "property_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Property Id",
          "type": "string"
        }
      },
      "required": [
        "hotel_observation_id",
        "offer_id",
        "property_id",
        "inventory_snapshot_id"
      ],
      "title": "HotelOfferRef",
      "type": "object"
    },
    "PlannerScope": {
      "additionalProperties": false,
      "description": "Optimistic-concurrency scope shared by one Planner decision round.",
      "properties": {
        "generation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Generation Id",
          "type": "string"
        },
        "protocol_version": {
          "const": "v4",
          "default": "v4",
          "title": "Protocol Version",
          "type": "string"
        },
        "task_book_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Book Id",
          "type": "string"
        },
        "task_book_state_version": {
          "minimum": 0,
          "title": "Task Book State Version",
          "type": "integer"
        },
        "task_book_version": {
          "minimum": 1,
          "title": "Task Book Version",
          "type": "integer"
        },
        "trip_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Trip Id",
          "type": "string"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "trip_id",
        "generation_id",
        "task_book_id",
        "task_book_version",
        "task_book_state_version",
        "workspace_revision"
      ],
      "title": "PlannerScope",
      "type": "object"
    }
  },
  "$id": "https://travel-agent.local/schemas/v4/formal-hotel-recommendation-set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exactly one best hotel and two intentionally differentiated alternatives.",
  "properties": {
    "alternative_hotels": {
      "items": {
        "$ref": "#/$defs/AlternativeHotelRecommendation"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Alternative Hotels",
      "type": "array"
    },
    "hotel_observation_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Hotel Observation Id",
      "type": "string"
    },
    "reason_summary": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason Summary",
      "type": "string"
    },
    "recommendation_set_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Recommendation Set Id",
      "type": "string"
    },
    "recommended_hotel": {
      "$ref": "#/$defs/BestHotelRecommendation"
    },
    "scope": {
      "$ref": "#/$defs/PlannerScope"
    }
  },
  "required": [
    "recommendation_set_id",
    "scope",
    "hotel_observation_id",
    "recommended_hotel",
    "alternative_hotels",
    "reason_summary"
  ],
  "title": "FormalHotelRecommendationSet",
  "type": "object"
}
